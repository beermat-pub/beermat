```calc {#r1 x=0 y=0}
x := 1
root(x^3 - 2*x - 5, x) = ?      #= 2.095
root(cos(x) - x, x, 0, 1) = ?   #= 0.739
```

```calc {#r2 x=0 y=57}
polyroots([-6; 11; -6; 1]) = ?   #= [1; 2; 3]
polyroots([1; 0; 1]) = ?         #= [-1i; 1i]
```

```calc {#r3 x=0 y=189}
a := 1 m
b := 4 m
given
a + b == 5 m
a*b == 6 m^2
find(a, b) = ?   #= [2; 3]*m
```

```calc {#r4 x=0 y=302}
x_d := [1; 2; 3; 4]
y_d := [2.1; 3.9; 6.2; 7.8]
a := 1
b := 0
given
a*x_d[0] + b == y_d[0]
a*x_d[1] + b == y_d[1]
a*x_d[2] + b == y_d[2]
a*x_d[3] + b == y_d[3]
minerr(a, b) = ?   #= [1.94; 0.15]
```
